rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Google provider present (including anonymous accounts later linked to Google).
    // Anonymous-only OCR / Live Activity sessions cannot read or write users/*.
    // Keep this Google-identity check: signed-in-but-anonymous is not enough.
    function isGoogleUser() {
      return isSignedIn()
        && 'google.com' in request.auth.token.firebase.identities;
    }

    function ownsUserTree(userId) {
      return isOwner(userId) && isGoogleUser();
    }

    match /devices/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /laSchedules/{id} {
      allow create: if isSignedIn()
        && request.resource.data.deviceId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.deviceId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.deviceId == request.auth.uid;
      allow read: if isSignedIn()
        && resource.data.deviceId == request.auth.uid;
    }
    match /geminiQuota/{modelId} {
      allow read, write: if false;
    }
    match /ocrRequests/{id} {
      allow read, write: if false;
    }

    // V3 user data. Never readable/writable by another uid.
    // PointTransaction writes are still client-side in Phase 8; a future
    // Cloud Function should be the only trusted writer for points.
    match /users/{userId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if ownsUserTree(userId);
      }
    }
  }
}
